# app.env.example  ->  copy to `app.env`
#
# `app.env` is passed to the APP only. It holds the least-privilege database role, not the admin.
# NEVER commit `app.env`. Every variable is explained above its line (Playbook DOC-07).
# (Comments sit on their own lines because some tools do not understand comments after a value.)

# development or production. The interactive docs page is on only in development.
APP_ENVIRONMENT=development
# Leave empty, or set a prefix such as /assistant when the app sits behind a proxy path.
APP_BASE_PATH=
APP_TIMEZONE=UTC

# "db" is the database service name in docker-compose.yml.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=example
# The least-privilege role you create in sql/schema.sql (it cannot create or drop tables).
POSTGRES_USER=app_user
POSTGRES_PASSWORD=<generate-a-strong-value>

# Language model. Any OpenAI-compatible provider works: change these three values to switch.
# The provider's documentation gives the base URL.
LLM_BASE_URL=<provider-base-url>
# Check the provider's current model list; names change.
LLM_MODEL=<model-name>
# Your personal key. Never commit it.
LLM_API_KEY=<your-key>
LLM_TIMEOUT_SECONDS=30
# Models to try, in order, when LLM_MODEL is unavailable, as a JSON list. Same provider.
LLM_FALLBACK_MODELS=[]
# Tries per model for 5xx, 429 and network errors, including the first try.
LLM_MAX_ATTEMPTS=3
# Upper limit on the length of each answer, in tokens.
LLM_MAX_OUTPUT_TOKENS=1024
# 0 for extraction. Raise it only for experiments.
LLM_TEMPERATURE=0
# Leave empty to send nothing. "none" turns thinking off on thinking models such as qwen3.5
# in Ollama: much faster, and the answer is not lost to max_tokens. Check your provider's docs.
LLM_REASONING_EFFORT=

# Parcels REST API. The default is the local training mock; use the address you were given.
PARCELS_API_BASE_URL=http://127.0.0.1:9000
# Seconds per call (connect, read, write). Every outbound call has a timeout (PY-12).
PARCELS_API_TIMEOUT_SECONDS=10
# Total tries per call, including the first, for 5xx, 429 and network errors.
PARCELS_API_MAX_ATTEMPTS=4
